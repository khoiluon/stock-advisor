# ============================================================
# Backend .dockerignore
# ============================================================
# Loại bỏ file không cần thiết khỏi Docker build context
# Giảm thời gian build và kích thước image
# ============================================================

__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Environment files (sử dụng .env.prod trên server)
.env
.env.*
!.env.example
!.env.example.prod

# Database
*.sqlite3
db.sqlite3

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Documentation
*.md

# Docker files (không cần trong image)
Dockerfile
Dockerfile.prod
.dockerignore

# Static files (sẽ được collectstatic tạo ra)
staticfiles/

# Test files
tests/
*.test