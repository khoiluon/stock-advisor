# ============================================================
# StockAdvisor — Production Environment Variables (Template)
# ============================================================
# Hướng dẫn:
#   1. Copy file này: cp backend/.env.example.prod backend/.env.prod
#   2. Thay thế tất cả <...> bằng giá trị thực
#   3. KHÔNG commit file .env.prod vào Git!
# ============================================================

# --- Django Core ---
SECRET_KEY=<thay-bang-secret-key-ngau-nhien-64-ky-tu>
DEBUG=False
ALLOWED_HOSTS=<EC2_PUBLIC_IP>,backend,localhost,127.0.0.1

# --- Database ---
DB_NAME=stock_advisor_db
DB_USER=root
DB_PASSWORD=<thay-bang-mat-khau-manh-cho-MySQL>
DB_HOST=db
DB_PORT=3306

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_HOST=redis

# --- CORS (thêm IP EC2 của bạn) ---
# Ví dụ: http://54.123.45.67,http://localhost
CORS_ALLOWED_ORIGINS=http://<EC2_PUBLIC_IP>
# Ví dụ: http://54.123.45.67,http://localhost
CSRF_TRUSTED_ORIGINS=http://<EC2_PUBLIC_IP>

# --- Third-party API Keys ---
FIRE_CRAWL_API_KEY=<your-fire-crawl-key>
EODHD_API_KEY=<your-eodhd-key>
GEMINI_API_KEY=<your-gemini-key>

# --- SSI FCData ---
SSI_FCDATA_CONSUMER_ID=<your-consumer-id>
SSI_FCDATA_CONSUMER_SECRET=<your-consumer-secret>
SSI_FCDATA_PUBLIC_KEY=<your-public-key>
SSI_FCDATA_PRIVATE_KEY=<your-private-key>