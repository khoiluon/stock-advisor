# ============================================================
# StockAdvisor — Backend Environment Variables
# ============================================================
# Copy file này thành .env và điền các giá trị thực:
#   cp .env.example .env
#
# QUAN TRỌNG: Không commit file .env lên Git!
# ============================================================

# --- Django Core ---
SECRET_KEY='your-secret-key-here'
DEBUG=True

# --- Database (MySQL) ---
# Khi chạy bằng Docker Compose, DB_HOST phải là 'db' (tên service)
# Khi chạy local (không Docker), DB_HOST là 'localhost'
DB_NAME='stock_advisor_db'
DB_USER='root'
DB_PASSWORD='123123'
DB_HOST='localhost'
DB_PORT='3306'

# --- Redis / Celery ---
# Khi chạy bằng Docker Compose: redis://redis:6379/0
# Khi chạy local: redis://localhost:6379/0
REDIS_URL='redis://localhost:6379/0'

# --- SSI FastConnect Data ---
# Đăng ký tại: https://iboard.ssi.com.vn/
SSI_FCDATA_CONSUMER_ID=your_consumer_id
SSI_FCDATA_CONSUMER_SECRET=your_consumer_secret
SSI_FCDATA_PUBLIC_KEY=your_public_key_base64
SSI_FCDATA_PRIVATE_KEY=your_private_key_base64

# --- SSI FastConnect Trading (tuỳ chọn) ---
SSI_FCTRADING_CONSUMER_ID=
SSI_FCTRADING_CONSUMER_SECRET=
SSI_FCTRADING_PUBLIC_KEY=
SSI_FCTRADING_PRIVATE_KEY=

# --- Firecrawl (Crawl tin tức) ---
FIRE_CRAWL_API_KEY=your_firecrawl_api_key

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key

# --- SSI URLs (thường không cần thay đổi) ---
SSI_FCDATA_URL='https://fc-data.ssi.com.vn/'
SSI_FCDATA_STREAM_URL='https://fc-datahub.ssi.com.vn/'
