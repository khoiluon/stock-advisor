# ============================================================
# StockAdvisor — Frontend Environment Variables
# ============================================================
# Copy file này thành .env và chỉnh sửa nếu cần:
#   cp .env.example .env
# ============================================================

# Backend API URL
# Khi chạy Docker Compose hoặc local dev, dùng localhost
VITE_API_URL=http://localhost:8000/api

# WebSocket URL (cho SSI real-time data)
# Không cần thêm /ws ở cuối — frontend code tự thêm /ws/stock/...
VITE_WS_URL=ws://localhost:8000
